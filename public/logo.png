<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200">
  <!-- Background -->
  <rect width="200" height="200" rx="20" fill="#F5F7FA"/>
  
  <!-- Speed lines (amber) -->
  <rect x="22" y="88" width="35" height="6" rx="3" fill="#F4B942"/>
  <rect x="18" y="100" width="42" height="6" rx="3" fill="#F4B942"/>
  <rect x="24" y="112" width="30" height="6" rx="3" fill="#F4B942"/>
  
  <!-- Truck body -->
  <rect x="68" y="95" width="110" height="48" rx="6" fill="#102A43"/>
  
  <!-- Truck cab -->
  <rect x="148" y="103" width="42" height="40" rx="6" fill="#102A43"/>
  
  <!-- Cab window -->
  <rect x="153" y="108" width="30" height="20" rx="3" fill="#4a90d9" opacity="0.6"/>
  
  <!-- House roof on truck -->
  <polygon points="70,95 125,58 180,95" fill="#102A43"/>
  
  <!-- House window on truck -->
  <rect x="105" y="68" width="22" height="22" rx="2" fill="#F4B942"/>
  <line x1="116" y1="68" x2="116" y2="90" stroke="#102A43" stroke-width="2"/>
  <line x1="105" y1="79" x2="127" y2="79" stroke="#102A43" stroke-width="2"/>
  
  <!-- Wheels -->
  <circle cx="100" cy="148" r="18" fill="#102A43"/>
  <circle cx="100" cy="148" r="10" fill="#526579"/>
  <circle cx="100" cy="148" r="4" fill="#F4B942"/>
  
  <circle cx="162" cy="148" r="18" fill="#102A43"/>
  <circle cx="162" cy="148" r="10" fill="#526579"/>
  <circle cx="162" cy="148" r="4" fill="#F4B942"/>
  
  <!-- Text: HaulHaven -->
  <text x="100" y="184" text-anchor="middle" font-family="Inter, Arial, sans-serif" font-size="11" font-weight="900" letter-spacing="1">
    <tspan fill="#102A43">Haul</tspan><tspan fill="#F4B942">Haven</tspan>
  </text>
  
  <!-- Underline dashes -->
  <rect x="40" y="188" width="25" height="3" rx="1.5" fill="#F4B942"/>
  <rect x="135" y="188" width="25" height="3" rx="1.5" fill="#F4B942"/>
</svg>
